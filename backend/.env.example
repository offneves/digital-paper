# Copie para .env e preencha os valores: cp .env.example .env

# Postgres
POSTGRES_AUTH_DB=digitalpaper_auth
POSTGRES_EMAIL_DB=digitalpaper_email
POSTGRES_NOTIFICATION_DB=digitalpaper_notification
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me

# Shared datasource credentials (per-service URL set below / in compose)
SPRING_DATASOURCE_USERNAME=admin
# Mesmo valor de POSTGRES_PASSWORD
SPRING_DATASOURCE_PASSWORD=change-me

# auth-ms
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres-auth:5432/digitalpaper_auth
APP_INTERNAL_API_KEY=change-me

# notification-ms (SPRING_DATASOURCE_URL overridden in compose)
# Mínimo de 32 caracteres; o mesmo segredo vale para todos os serviços
APP_JWT_SECRET=change-me-to-a-secret-with-32-chars-or-more
APP_AUTH_BASE_URL=http://auth-ms:8081

# RabbitMQ
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# email-ms (SPRING_DATASOURCE_URL overridden in compose)
# Gmail: use uma senha de app (https://myaccount.google.com/apppasswords), não a senha da conta.
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
APP_MAIL_FROM=
# true = não envia, só registra os links no log do email-ms
APP_MAIL_DRY_RUN=false
